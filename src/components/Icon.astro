const stroked =
  name === 'sun' || name === 'moon' || name === 'arrow' || name === 'chevron';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={stroked ? 'none' : 'currentColor'}
  stroke={stroked ? 'currentColor' : 'none'}
  stroke-width={stroked ? 1.8 : undefined}
  stroke-linecap={stroked ? 'round' : undefined}
  stroke-linejoin={stroked ? 'round' : undefined}
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
