---
interface Props {
  name:
    | 'scholar'
    | 'github'
    | 'email'
    | 'blog'
    | 'wechat'
    | 'x'
    | 'sun'
    | 'moon'
    | 'arrow'
    | 'chevron';
  class?: string;
}
const { name, class: className = 'h-4 w-4' } = Astro.props;

/**
 * All paths use a 24x24 viewBox.
 *
 * `scholar`, `github`, `wechat` and `x` are the official brand marks, copied from
 * the `simple-icons` package rather than redrawn by hand — the previous
 * hand-drawn Scholar cap had a stray bar on its right edge.
 *
 * `email` and `blog` are solid glyphs on purpose: every icon that sits inside a
 * coloured brand tile is filled, so mixing in stroke icons would read as two
 * different sets. `blog` is a camera because that is what the linked blog holds.
 *
 * `sun`/`moon`/`arrow`/`chevron` are stroked and used outside the tiles.
 */
