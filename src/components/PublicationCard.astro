---
import type { Publication } from '../data/publications.ts';

interface Props {
  publication: Publication;
}
const { publication } = Astro.props;
---

<article class="group grid gap-5 sm:grid-cols-[15rem_1fr] sm:gap-6">
  <div
    class="relative overflow-hidden rounded-xl bg-line-soft ring-1 ring-line"
  >
    <img
      src={publication.image}
      alt={publication.title}
      loading="lazy"
      decoding="async"
      class="aspect-[5/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </div>

  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class="rounded bg-accent-soft px-1.5 py-0.5 text-[0.6875rem] font-semibold text-accent"
      >
        {publication.venue} {publication.year}
      </span>
      {
        publication.short && (
          <span class="label">{publication.short}</span>
        )
      }
    </div>

    <h3 class="mt-2 text-base font-semibold leading-snug text-ink">
      {publication.title}
    </h3>

    <p class="mt-1.5 text-sm leading-6 text-ink-faint">
      {
        publication.authors.map((author, index) => (
          <>
            <span class={author.me ? 'font-semibold text-ink-soft' : ''}>
              {author.name}{author.equal && '*'}
            </span>
            {index < publication.authors.length - 1 && ', '}
          </>
        ))
      }
    </p>

    {
      publication.note && (
        <p class="mt-1.5 text-sm font-medium text-gold">{publication.note}</p>
      )
    }

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      {
        publication.links?.map((link) => (
          <a href={link.href} class="text-[0.8125rem] font-medium">
            {link.label} <span class="text-ink-faint">↗</span>
          </a>
        ))
      }
      {
        publication.starsRepo && (
          <img
            src={`https://img.shields.io/github/stars/${publication.starsRepo}?style=flat&label=%20&color=e6eaf0&labelColor=7a7e87&logo=github&logoColor=white`}
            alt={`GitHub stars for ${publication.starsRepo}`}
            height="20"
            class="h-5"
            loading="lazy"
          />
        )
      }
    </div>
  </div>
</article>
